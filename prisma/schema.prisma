// Prisma Schema for PostgreSQL / Supabase
// THE ASHH STORE - Production Database Specification

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  MANAGER
  SUPPORT
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  RAZORPAY
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum RefundMethod {
  BANK_ACCOUNT
  STORE_CREDIT
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  phone         String?
  passwordHash  String?
  role          Role      @default(CUSTOMER)
  walletBalance Float     @default(0.0)
  isMember      Boolean   @default(false)
  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  wishlist      String[]  // Array of product IDs
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Address {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  phone        String
  addressLine1 String
  addressLine2 String?
  landmark     String?
  city         String
  state        String
  pincode      String
  addressType  String   @default("Home")
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model Product {
  id                   String           @id @default(uuid())
  title                String
  slug                 String           @unique
  description          String
  highlights           String[]
  category             String
  fandom               String?
  gender               String           @default("unisex")
  fit                  String           @default("Oversized Fit")
  fabric               String
  gsm                  Int
  washCare             String[]
  price                Float
  mrp                  Float
  discountPercentage   Int
  memberPrice          Float?
  hsnCode              String           @default("61091000")
  gstRate              Int              @default(5)
  rating               Float            @default(4.8)
  reviewCount          Int              @default(0)
  isBestseller         Boolean          @default(false)
  isNewArrival         Boolean          @default(false)
  isTrending           Boolean          @default(false)
  officialLicenseBadge String?
  tags                 String[]
  images               ProductImage[]
  variants             ProductVariant[]
  reviews              Review[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  angle     String?
  isModel   Boolean @default(false)
}

model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String  @unique
  size      String
  color     String
  colorHex  String
  stock     Int     @default(0)
}

model Order {
  id                String         @id @default(uuid())
  orderNumber       String         @unique
  userId            String?
  user              User?          @relation(fields: [userId], references: [id])
  customerName      String
  customerEmail     String
  customerPhone     String
  items             OrderItem[]
  shippingAddress   Json
  billingAddress    Json
  paymentMethod     PaymentMethod
  paymentStatus     PaymentStatus  @default(PENDING)
  razorpayOrderId   String?
  razorpayPaymentId String?
  subtotal          Float
  couponCode        String?
  couponDiscount    Float          @default(0.0)
  shippingFee       Float          @default(0.0)
  codFee            Float          @default(0.0)
  taxBreakdown      Json
  grandTotal        Float
  orderStatus       OrderStatus    @default(PLACED)
  courierAwb        String?
  courierName       String?
  courierTracking   Json?
  returnRequest     ReturnRequest?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  title     String
  image     String
  size      String
  color     String
  quantity  Int
  price     Float
  mrp       Float
  hsnCode   String
  gstRate   Int
}

model ReturnRequest {
  id           String       @id @default(uuid())
  orderId      String       @unique
  order        Order        @relation(fields: [orderId], references: [id])
  reason       String
  comments     String?
  refundMethod RefundMethod
  bankUpiId    String?
  status       String       @default("pending")
  refundAmount Float
  requestedAt  DateTime     @default(now())
}

model Coupon {
  id            String    @id @default(uuid())
  code          String    @unique
  description   String
  discountType  String    @default("percentage")
  discountValue Float
  minOrderValue Float     @default(0.0)
  maxDiscount   Float?
  validFrom     DateTime  @default(now())
  validTill     DateTime
  usageLimit    Int?
  usageCount    Int       @default(0)
  isActive      Boolean   @default(true)
}

model Review {
  id               String   @id @default(uuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  userName         String
  rating           Int
  title            String
  comment          String
  photos           String[]
  verifiedPurchase Boolean  @default(true)
  helpfulCount     Int      @default(0)
  createdAt        DateTime @default(now())
}
