NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME="THE ASHH STORE"
JWT_SECRET=super-secret-jwt-key-for-the-ashh-store-production-2026

# Database
# If MongoDB or PostgreSQL is provided, the app connects to it; otherwise falls back to robust local persistent store.
MONGODB_URI=mongodb://localhost:27017/the-ashh-store
DATABASE_URL=postgresql://postgres:password@localhost:5432/the_ashh_store?schema=public

# Razorpay Payments (UPI, Cards, Netbanking)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_ashhStore7890
RAZORPAY_KEY_ID=rzp_test_ashhStore7890
RAZORPAY_KEY_SECRET=ashhStoreRazorpaySecretKey2026

# Shipping & Courier (Shiprocket API / Mock Adapter)
SHIPROCKET_EMAIL=logistics@theashhstore.com
SHIPROCKET_PASSWORD=shiprocket_demo_pass_2026
SHIPROCKET_API_TOKEN=mock_shiprocket_token_ashh_express

# SMS & OTP (MSG91 / Twilio)
MSG91_AUTH_KEY=mock_msg91_auth_key_123
TWILIO_ACCOUNT_SID=mock_twilio_account_sid
TWILIO_AUTH_TOKEN=mock_twilio_auth_token

# Email (SendGrid / Nodemailer)
SENDGRID_API_KEY=mock_sendgrid_key
EMAIL_FROM=support@theashhstore.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@theashhstore.com
SMTP_PASS=demo_app_password

# Image Uploads (Cloudinary / S3)
CLOUDINARY_CLOUD_NAME=the-ashh-store
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=mock_cloudinary_secret_key
